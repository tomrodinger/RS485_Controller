# For PCBs designed using KiCad: https://www.kicad.org/
# Format documentation: https://kicad.org/help/file-formats/

# Temporary files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups
*-cache*
*-bak
*-bak*
*~
~*
_autosave-*
\#auto_saved_files\#
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache
~*.lck
\#auto_saved_files#

# Netlist files (exported from Eeschema)
*.net

# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

# Exported BOM files
*.xml
*.csv

# Archived Backups (KiCad 6.0)
**/*-backups/*.zip

# Local project settings
*.kicad_prl

.DS_Store

# Local Python environments and bytecode
.venv*/
__pycache__/
*.py[cod]

# Regenerable PDF review renders; keep the JSON render manifests
/datasheet/review/v*-pages/*.png
/datasheet/review/*-preview.png
/diagram-review/reviews/qa/*.png

# The gallery has its own already-pushed private Sites repository.
# Never add its Git database, account feedback database, credentials or caches here.
/diagram-review/site/

# Generic local application build caches
node_modules/
.wrangler/
.sites-runtime/
*.tsbuildinfo
